# =============================================================================
# Novita 中转 API key 配置
# =============================================================================
# 把本文件复制为 .env 后,把 sk-xxx 替换成你的真实 Novita key:
#   cp .env.example .env
#
# 项目统一走 Novita 的 anthropic 兼容协议 (Claude Agent SDK).
# 模型清单由 pentaloom/config/models.json 管理,不在此处配置.
# =============================================================================

# ---------- Novita 中转 (anthropic 兼容协议) ----------
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.novita.ai/anthropic

# ---------- Tavily web search (可选, 不配则搜索能力不可用) ----------
# 免费 1000 次/月, 注册拿 key: https://app.tavily.com
TAVILY_API_KEY=tvly-xxx

# ---------- Bocha 博查 web search (可选, 国内 provider) ----------
# 中文结果好. 配了就支持 region=cn/both. 免费试用 1000 次. https://open.bochaai.com
BOCHA_API_KEY=sk-xxx
